17":"assets/photos-5617.webp","5618":"assets/photos-5618.webp","5619":"assets/photos-5619.webp","5620":"assets/photos-5620.webp","5621":"assets/photos-5621.webp","5622":"assets/photos-5622.webp","5623":"assets/photos-5623.webp","5624":"assets/photos-5624.webp","helmet118":"assets/photos-helmet118.webp","helmet35":"assets/photos-helmet35.webp"},"groups":[{"id":"forest","title":"Мухавецкое лесничество","tag":"Природа и школа","photos":[5584,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594],"text":"Стенд об истории местного лесничества и школьного лесничества. Фотографии и тексты сохранены в исходном виде."},{"id":"afghan","title":"Воины-интернационалисты","tag":"История и память","photos":[5597,5598,5599,5600,5601,5602],"text":"Фотографии участников войны в Афганистане и встреч со школьниками. Подробности — на фотографиях стенда."},{"id":"division","title":"160-я Брестская стрелковая дивизия","tag":"1941–1945","photos":[5612,5611,5610],"text":"Экспозиция о боевом пути дивизии. Карта, портреты, документы и снимки встреч ветеранов."},{"id":"honour","title":"Чтим","tag":"Военная история","photos":[5607,5606],"text":"Стенд о 204-м гаубично-артиллерийском полке и 22-й танковой дивизии."},{"id":"memory","title":"Помним","tag":"Осень 1942 года","photos":[5605,5604,5603],"text":"Мемориальная экспозиция о погибших мирных жителях. Имена и рассказы представлены на исходных фотографиях."},{"id":"helmets","title":"Каски и военные предметы","tag":"Предметы экспозиции","photos":["helmet118","helmet35",5577],"text":"Форма касок уточнена по крупным кадрам видео: вытянутый купол, козырёк, край и заклёпки. Потёртая поверхность взята из съёмки музейного экспоната."},{"id":"history","title":"Они сражались за землю и волю","tag":"История края","photos":[5608,5609,5613,5614,5615],"text":"Портреты и биографические подписи на узком стенде между экспозициями."},{"id":"house","title":"Предметы старого быта","tag":"Этнографический уголок","photos":[5620,5621,5617,5616],"text":"Печь, прялки, корзины, утюги, глиняная посуда и вышивка. В этой версии сложные предметы воссозданы в упрощённой форме."},{"id":"letters","title":"Письма и школьные архивы","tag":"Архив","photos":[5596,5595],"text":"Подлинные фотографии музейной подборки писем, открыток и встреч школьных следопытов."},{"id":"everyday","title":"Утюги, фонари и инструменты","tag":"Коллекция предметов","photos":[5624,5623],"text":"Угольные и литые утюги, керосиновые фонари и настольная лампа. В фонарях видны стеклянные колбы, горелки, защитная проволока и ручки; у утюгов — крышки, шарниры и отверстия для воздуха."},{"id":"room","title":"Музей на фотографиях","tag":"Исходные материалы","photos":[5577,5578,5579,5580,5618,5619,5622],"text":"Общие виды, на которых основана реконструкция. Размеры помещения оценены, точные замеры не предоставлены."}]}